# Application
APP_ENV=development
APP_NAME=LinkShield
APP_VERSION=0.1.0
LOG_LEVEL=INFO

# Frontend origin used for CORS allowlisting (comma-separated in production)
FRONTEND_ORIGIN=http://localhost:5173

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
PUBLIC_API_BASE_URL=http://localhost:8000

# Database — leave empty to run without persistence (in-memory scan store)
# Example: postgresql+psycopg2://linkshield:linkshield@localhost:5432/linkshield
DATABASE_URL=

# Optional threat intelligence (leave empty to use local analysis only)
GOOGLE_SAFE_BROWSING_API_KEY=
VIRUSTOTAL_API_KEY=

# Whether the UI/API may offer sending URLs to third-party providers
EXTERNAL_INTEL_ENABLED=true

# Rate limiting
RATE_LIMIT_SCAN_PER_MINUTE=10
RATE_LIMIT_READ_PER_MINUTE=60

# Outbound request controls
OUTBOUND_TIMEOUT_SECONDS=5
OUTBOUND_MAX_REDIRECTS=5
OUTBOUND_MAX_RESPONSE_BYTES=65536
OUTBOUND_CONNECT_TIMEOUT_SECONDS=3

# History / retention
DEFAULT_SCAN_TTL_HOURS=24
PERSISTED_SCAN_TTL_DAYS=30
STATS_ENABLED=true

# Optional RDAP domain registration lookup (sends the domain, not the full URL)
RDAP_ENABLED=true
RDAP_BASE_URL=https://rdap.org/domain

# Session cookie
SESSION_COOKIE_NAME=ls_client
SESSION_COOKIE_SECURE=false
